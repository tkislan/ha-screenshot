{
  "compilerOptions": {
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "target": "esnext",
    "module": "nodenext",
    // page.evaluate() callbacks run in Chromium, so they are checked against the DOM types.
    "lib": ["esnext", "dom"],
    "types": ["node"],
    "erasableSyntaxOnly": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true
  },
  "include": ["src", "test"]
}
